{
  "name": "pomodoro",
  "version": "3.12.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MkMan/pomodoro"
  },
  "type": "module",
  "scripts": {
    "build": "vite build --base /pomodoro",
    "e2e:open": "concurrently -k -s first \"npm start\" \"cypress open\"",
    "e2e:run": "concurrently -k -s first \"npm start\" \"cypress run\"",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint:check": "oxlint --report-unused-disable-directives --max-warnings=0 . && markdownlint .",
    "lint:fix": "oxlint . --fix && markdownlint . --fix",
    "prepare": "husky install",
    "preview": "vite preview",
    "sanity-check": "npm run lint:check && npm run format:check && npm run ts:check && npm test && npm run e2e:run",
    "start": "vite --open --port 3000 --base /pomodoro",
    "test:watch": "vitest watch --coverage",
    "test": "vitest run --coverage",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/playpen-sans": "^5.1.0",
    "@fontsource/raleway": "^5.1.0",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "@vanilla-extract/css": "^1.16.0",
    "solid-icons": "^1.1.0",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@commitlint/cli": "18.2.0",
    "@commitlint/config-conventional": "18.1.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@solidjs/testing-library": "^0.8.4",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/user-event": "^14.5.1",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "8.2.2",
    "cypress": "^15.20.1",
    "eslint": "9",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-solid": "^0.16.0",
    "eslint-plugin-testing-library": "7.16.2",
    "gh-pages": "^6.0.0",
    "husky": "8.0.3",
    "identity-obj-proxy": "3.0.0",
    "jsdom": "^22.1.0",
    "lint-staged": "15.0.2",
    "markdownlint": "0.31.1",
    "markdownlint-cli": "0.37.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "semantic-release": "22.0.7",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10",
    "wait-on": "^7.1.0",
    "workbox-window": "^7.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.md": "markdownlint --fix"
  },
  "engines": {
    "node": "22.23.2"
  }
}
